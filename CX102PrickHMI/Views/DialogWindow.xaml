<hc:Window
    x:Class="CX102PrickHMI.Views.DialogWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    Title="提示"
    Width="360"
    SizeToContent="Height"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    FontFamily="{DynamicResource AppFont}"
    PreviewKeyDown="Window_PreviewKeyDown">
    <hc:Window.Resources>
        <Storyboard x:Key="AlarmBorderPulse">
            <ColorAnimation
                Storyboard.TargetName="CardBorder"
                Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                From="#EF4444"
                To="#66EF4444"
                Duration="0:0:0.8"
                AutoReverse="True"
                RepeatBehavior="Forever" />
            <DoubleAnimation
                Storyboard.TargetName="CardBorder"
                Storyboard.TargetProperty="(Border.Effect).(DropShadowEffect.Opacity)"
                From="0.7"
                To="0.3"
                Duration="0:0:0.8"
                AutoReverse="True"
                RepeatBehavior="Forever" />
        </Storyboard>
    </hc:Window.Resources>
    <Border
        x:Name="CardBorder"
        Margin="16"
        Padding="20"
        Background="{StaticResource Surface}"
        BorderBrush="{StaticResource Line}"
        BorderThickness="2"
        CornerRadius="10">
        <Grid Margin="4,8,4,4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock
                Text="{Binding Message, RelativeSource={RelativeSource AncestorType={x:Type hc:Window}}}"
                Foreground="{StaticResource Ink}"
                FontSize="14"
                TextWrapping="Wrap" />
            <Button
                x:Name="OkButton"
                Grid.Row="1"
                HorizontalAlignment="Right"
                Margin="0,20,0,0"
                Content="确定"
                Style="{StaticResource PrimaryButtonStyle}"
                Click="OkButton_Click" />
        </Grid>
    </Border>
</hc:Window>