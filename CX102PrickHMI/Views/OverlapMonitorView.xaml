<UserControl
    x:Class="CX102PrickHMI.Views.OverlapMonitorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="clr-namespace:HslControls.WPF;assembly=HslControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <UserControl.Resources>
        <DrawingBrush
            x:Key="PageGridBrush"
            TileMode="Tile"
            Viewport="0,0,40,40"
            ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <GeometryDrawing Geometry="M0,0 L40,0 M0,0 L0,40">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#1F374151" Thickness="1" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <Style x:Key="PositionBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Padding" Value="10,2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#190EA5E9" />
            <Setter Property="BorderBrush" Value="#4D0EA5E9" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style
            x:Key="PositionBadgeAlertStyle"
            BasedOn="{StaticResource PositionBadgeStyle}"
            TargetType="Border">
            <Setter Property="Background" Value="#19EF4444" />
            <Setter Property="BorderBrush" Value="#66EF4444" />
        </Style>
        <Style x:Key="StatusOkStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#1A22C55E" />
            <Setter Property="BorderBrush" Value="#4D22C55E" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style
            x:Key="StatusAlertStyle"
            BasedOn="{StaticResource StatusOkStyle}"
            TargetType="Border">
            <Setter Property="Background" Value="#26EF4444" />
            <Setter Property="BorderBrush" Value="#66EF4444" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource PageGridBrush}">
        <Viewbox Stretch="UniformToFill">
            <Grid
                Width="1280"
                Height="600"
                Margin="24,12,24,12"
                Background="{StaticResource PageGridBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  行0：报警横幅（状态驱动）  -->
                <Border
                    Grid.Row="0"
                    Margin="0,12,0,12"
                    Padding="24,14"
                    BorderThickness="2"
                    CornerRadius="4">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect
                                        BlurRadius="0"
                                        Direction="0"
                                        Opacity="0"
                                        ShadowDepth="0"
                                        Color="#EF4444" />
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasAnySpliceWarning}" Value="True">
                                    <Setter Property="BorderBrush" Value="{StaticResource Warning}" />
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect
                                                BlurRadius="20"
                                                Opacity="0.5"
                                                ShadowDepth="0"
                                                Color="#F59E0B" />
                                        </Setter.Value>
                                    </Setter>
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard Name="BannerWarningPulse">
                                            <Storyboard AutoReverse="True" RepeatBehavior="Forever">
                                                <ColorAnimation
                                                    Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                    From="#F59E0B"
                                                    To="#66F59E0B"
                                                    Duration="0:0:0.8" />
                                                <DoubleAnimation
                                                    Storyboard.TargetProperty="(Border.Effect).(DropShadowEffect.Opacity)"
                                                    From="0.5"
                                                    To="0.2"
                                                    Duration="0:0:0.8" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <StopStoryboard BeginStoryboardName="BannerWarningPulse" />
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasAnySpliceAlarm}" Value="True">
                                    <Setter Property="BorderBrush" Value="#EF4444" />
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect
                                                BlurRadius="24"
                                                Opacity="0.35"
                                                ShadowDepth="0"
                                                Color="#EF4444" />
                                        </Setter.Value>
                                    </Setter>
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard Name="BannerPulse">
                                            <Storyboard AutoReverse="True" RepeatBehavior="Forever">
                                                <ColorAnimation
                                                    Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                    From="#EF4444"
                                                    To="#66EF4444"
                                                    Duration="0:0:0.8" />
                                                <DoubleAnimation
                                                    Storyboard.TargetProperty="(Border.Effect).(DropShadowEffect.Opacity)"
                                                    From="0.7"
                                                    To="0.3"
                                                    Duration="0:0:0.8" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <StopStoryboard BeginStoryboardName="BannerPulse" />
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                            <Ellipse Width="14" Height="14">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource Success}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasAnySpliceWarning}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource Warning}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HasAnySpliceAlarm}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource Error}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock
                                Margin="16,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="18"
                                FontWeight="Bold"
                                Text="{Binding BannerText}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource Success}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasAnySpliceWarning}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource Warning}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HasAnySpliceAlarm}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource Error}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Ellipse
                                Width="14"
                                Height="14"
                                Margin="16,0,0,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource Success}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasAnySpliceWarning}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource Warning}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HasAnySpliceAlarm}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource Error}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                        </StackPanel>
                    </Grid>
                </Border>

                <!--  行1：三卡片  -->
                <UniformGrid Grid.Row="1" Columns="3">

                    <!--  P-01 前段搭接  -->
                    <Border
                        Margin="0,0,24,0"
                        Padding="20"
                        Background="{StaticResource Surface}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{StaticResource Border}" />
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect
                                            BlurRadius="0"
                                            Direction="0"
                                            Opacity="0"
                                            ShadowDepth="0"
                                            Color="#EF4444" />
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SpliceValue1Warning}" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource Warning}" />
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect
                                                    BlurRadius="40"
                                                    Opacity="0.55"
                                                    ShadowDepth="0"
                                                    Color="#F59E0B" />
                                            </Setter.Value>
                                        </Setter>
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard Name="CardPulseWarning1">
                                                <Storyboard AutoReverse="True" RepeatBehavior="Forever">
                                                    <ColorAnimation
                                                        Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                        From="#F59E0B"
                                                        To="#66F59E0B"
                                                        Duration="0:0:0.8" />
                                                    <DoubleAnimation
                                                        Storyboard.TargetProperty="(Border.Effect).(DropShadowEffect.Opacity)"
                                                        From="0.55"
                                                        To="0.25"
                                                        Duration="0:0:0.8" />
                                                    <DoubleAnimation
                                                        Storyboard.TargetProperty="(Border.Effect).(DropShadowEffect.BlurRadius)"
                                                        From="40"
                                                        To="16"
                                                        Duration="0:0:0.8" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="CardPulseWarning1" />
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SpliceValue1OutOfRange}" Value="True">
                                        <Setter Property="BorderBrush" Value="#EF4444" />
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect
                                                    BlurRadius="50"
                                                    Opacity="0.7"
                                                    ShadowDepth="0"
                                                    Color="#EF4444" />
                                            </Setter.Value>
                                        </Setter>
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard Name="CardPulse1">
                                                <Storyboard AutoReverse="True" RepeatBehavior="Forever">
                                                    <ColorAnimation
                                                        Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                        From="#EF4444"
                                                        To="#66EF4444"
                                                        Duration="0:0:0.8" />
                                                    <DoubleAnimation
                                                        Storyboard.TargetProperty="(Border.Effect).(DropShadowEffect.Opacity)"
                                                        From="0.7"
                                                        To="0.3"
                                                        Duration="0:0:0.8" />
                                                    <DoubleAnimation
                                                        Storyboard.TargetProperty="(Border.Effect).(DropShadowEffect.BlurRadius)"
                                                        From="50"
                                                        To="20"
                                                        Duration="0:0:0.8" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="CardPulse1" />
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.Resources>
                                <Style x:Key="CornerStyle1" TargetType="Path">
                                    <Setter Property="Stroke" Value="{StaticResource Primary}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SpliceValue1Warning}" Value="True">
                                            <Setter Property="Stroke" Value="{StaticResource Warning}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SpliceValue1OutOfRange}" Value="True">
                                            <Setter Property="Stroke" Value="{StaticResource Error}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Resources>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Path
                                Margin="-10,-13,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Data="M 16 2 L 2 2 L 2 16"
                                Stretch="None"
                                StrokeThickness="2"
                                Style="{StaticResource CornerStyle1}" />
                            <Path
                                Margin="0,-13,-10,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Data="M 2 2 L 16 2 L 16 16"
                                Stretch="None"
                                StrokeThickness="2"
                                Style="{StaticResource CornerStyle1}" />
                            <Path
                                Grid.Row="4"
                                Margin="-6,0,0,-24"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Bottom"
                                Data="M 2 2 L 2 16 L 16 16"
                                Stretch="None"
                                StrokeThickness="2"
                                Style="{StaticResource CornerStyle1}" />
                            <Path
                                Grid.Row="4"
                                Margin="0,0,-8,-23"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Data="M 16 2 L 16 16 L 2 16"
                                Stretch="None"
                                StrokeThickness="2"
                                Style="{StaticResource CornerStyle1}" />

                            <Border
                                Margin="0,0,0,16"
                                Padding="0,0,0,12"
                                BorderBrush="{StaticResource Line}"
                                BorderThickness="0,0,0,1">
                                <DockPanel>
                                    <Border
                                        Margin="8,0,0,0"
                                        Padding="8,3"
                                        VerticalAlignment="Center"
                                        BorderThickness="1"
                                        CornerRadius="2"
                                        DockPanel.Dock="Right">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#1A22C55E" />
                                                <Setter Property="BorderBrush" Value="#4D22C55E" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SpliceValue1Warning}" Value="True">
                                                        <Setter Property="Background" Value="#1AF59E0B" />
                                                        <Setter Property="BorderBrush" Value="#66F59E0B" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SpliceValue1OutOfRange}" Value="True">
                                                        <Setter Property="Background" Value="#26EF4444" />
                                                        <Setter Property="BorderBrush" Value="#66EF4444" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="14" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource Success}" />
                                                    <Setter Property="Text" Value="NORMAL" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SpliceValue1Warning}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource Warning}" />
                                                            <Setter Property="Text" Value="WARN" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SpliceValue1OutOfRange}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource Error}" />
                                                            <Setter Property="Text" Value="ALARM" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                    <Border>
                                        <Border.Style>
                                            <Style BasedOn="{StaticResource PositionBadgeStyle}" TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SpliceValue1Warning}" Value="True">
                                                        <Setter Property="Background" Value="#19F59E0B" />
                                                        <Setter Property="BorderBrush" Value="#66F59E0B" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SpliceValue1OutOfRange}" Value="True">
                                                        <Setter Property="Background" Value="#19EF4444" />
                                                        <Setter Property="BorderBrush" Value="#66EF4444" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock
                                                FontFamily="Consolas"
                                                FontSize="16"
                                                FontWeight="Bold"
                                                Text="P-01">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource Primary}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SpliceValue1Warning}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource Warning}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding SpliceValue1OutOfRange}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource Error}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock
                                                Margin="10,0,0,0"
                                                FontSize="15"
                                                Foreground="{StaticResource Ink2}"
                                                Text="操作侧搭接" />
                                        </StackPanel>
                                    </Border>
                                </DockPanel>
                            </Border>

                            <Viewbox
                                Grid.Row="1"
                                Margin="0,8,0,0"
                                Stretch="Uniform">
                                <ctl:HslArcGauge
                                    Width="240"
                                    Height="160"
                                    HorizontalAlignment="Center"
                                    ArcGaugeFormat="F1"
                                    Background="Transparent"
                                    Foreground="{StaticResource Ink2}"
                                    GaugeUnit="mm"
                                    Max="8"
                                    Min="0"
                                    SettingGaugeColor="{StaticResource Warning}"
                                    SettingValue="4"
                                    Value="{Binding SpliceValue1Value}">
                                    <ctl:HslArcGauge.Style>
                                        <Style TargetType="ctl:HslArcGauge">
                                            <Setter Property="GaugeColor" Value="{StaticResource Success}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SpliceValue1Warning}" Value="True">
                                                    <Setter Property="GaugeColor" Value="{StaticResource Warning}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SpliceValue1OutOfRange}" Value="True">
                                                    <Setter Property="GaugeColor" Value="{StaticResource Error}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ctl:HslArcGauge.Style>
                                </ctl:HslArcGauge>
                            </Viewbox>

                            <DockPanel Grid.Row="2" Margin="0,10,0,0">
                                <TextBlock
                                    DockPanel.Dock="Left"
                                    FontSize="17"
                                    Foreground="{StaticResource Ink3}"
                                    Text="搭接示意 / OVERLAP SCHEMATIC" />
                                <Rectangle
                                    Height="1"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center"
                                    Fill="#80374151" />
                            </DockPanel>
                            <Viewbox
                                Grid.Row="3"
                                MaxWidth="347"
                                Stretch="Uniform">
                                <Canvas Width="400" Height="110">
                                    <Rectangle
                                        Canvas.Left="21"
                                        Canvas.Top="45"
                                        Width="200"
                                        Height="40"
                                        Stroke="#6B7280">
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Offset="0" Color="#475569" />
                                                <GradientStop Offset="1" Color="#374151" />
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                    <Rectangle
                                        Canvas.Left="179"
                                        Canvas.Top="45"
                                        Width="200"
                                        Height="40"
                                        Stroke="#7B8290">
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Offset="0" Color="#5A6478" />
                                                <GradientStop Offset="1" Color="#475569" />
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                    <TextBlock
                                        Canvas.Left="29"
                                        Canvas.Top="55"
                                        FontSize="16"
                                        Foreground="#99FFFFFF"
                                        Text="材料A" />
                                    <TextBlock
                                        Canvas.Left="187"
                                        Canvas.Top="55"
                                        FontSize="16"
                                        Foreground="#99FFFFFF"
                                        Text="材料B" />
                                    <Rectangle
                                        Canvas.Left="179"
                                        Canvas.Top="45"
                                        Width="42"
                                        Height="40"
                                        StrokeDashArray="3 2">
                                        <Rectangle.Style>
                                            <Style TargetType="Rectangle">
                                                <Setter Property="Fill" Value="#1422C55E" />
                                                <Setter Property="Stroke" Value="{StaticResource Success}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SpliceValue1Warning}" Value="True">
                                                        <Setter Property="Fill" Value="#1AF59E0B" />
                                                        <Setter Property="Stroke" Value="{StaticResource Warning}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SpliceValue1OutOfRange}" Value="True">
                                                        <Setter Property="Fill" Value="#1AEF4444" />
                                                        <Setter Property="Stroke" Value="{StaticResource Error}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Rectangle.Style>
                                    </Rectangle>
                                    <Path Data="M 179 38 L 221 38 M 179 34 L 179 42 M 221 34 L 221 42">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Stroke" Value="{StaticResource Success}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SpliceValue1Warning}" Value="True">
                                                        <Setter Property="Stroke" Value="{StaticResource Warning}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SpliceValue1OutOfRange}" Value="True">
                                                        <Setter Property="Stroke" Value="{StaticResource Error}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                    <TextBlock
                                        Canvas.Left="164"
                                        Canvas.Top="12"
                                        Width="72"
                                        FontFamily="Consolas"
                                        FontSize="18"
                                        Text="{Binding SpliceValue1Value, StringFormat={}{0:F1}mm}"
                                        TextAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource Success}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SpliceValue1Warning}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource Warning}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SpliceValue1OutOfRange}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource Error}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Canvas>
                            </Viewbox>

                            <Border
                                Grid.Row="4"
                                Margin="0,10,0,0"
                                Padding="0,12,0,0"
                                BorderBrush="{StaticResource Line}"
                                BorderThickness="0,1,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            FontSize="16"
                                            Foreground="{StaticResource Ink3}"
                                            Text="标准: " />
                                        <TextBlock
                                            FontSize="16"
                                            FontWeight="Bold"
                                            Foreground="{StaticResource Ink2}"
                                            Text="4±2mm" />
                                    </StackPanel>
                                    <TextBlock
                                        Grid.Column="1"
                                        HorizontalAlignment="Right"
                                        FontSize="16"
                                        FontWeight="Bold"
                                        Text="{Binding SpliceValue1Delta}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource Success}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SpliceValue1Warning}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource Warning}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SpliceValue1OutOfRange}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource Error}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!--  P-02 中段搭接  -->
                    <Border
                        Margin="0,0,24,0"
                        Padding="20"
                        Background="{StaticResource Surface}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{StaticResource Border}" />
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect
                                            BlurRadius="0"
                                            Direction="0"
                                            Opacity="0"
                                            ShadowDepth="0"
                                            Color="#EF4444" />
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SpliceValue2Warning}" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource Warning}" />
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect
