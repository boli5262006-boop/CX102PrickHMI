<UserControl
    x:Class="CX102PrickHMI.Views.OverlapMonitorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:ctl="clr-namespace:HslControls.WPF;assembly=HslControls">
    <UserControl.Resources>
        <DrawingBrush
            x:Key="PageGridBrush"
            TileMode="Tile"
            Viewport="0,0,40,40"
            ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <GeometryDrawing Geometry="M0,0 L40,0 M0,0 L0,40">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#1F374151" Thickness="1" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <Style x:Key="PositionBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Padding" Value="10,2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#190EA5E9" />
            <Setter Property="BorderBrush" Value="#4D0EA5E9" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="PositionBadgeAlertStyle" TargetType="Border" BasedOn="{StaticResource PositionBadgeStyle}">
            <Setter Property="Background" Value="#19EF4444" />
            <Setter Property="BorderBrush" Value="#66EF4444" />
        </Style>
        <Style x:Key="StatusOkStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#1A22C55E" />
            <Setter Property="BorderBrush" Value="#4D22C55E" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="StatusAlertStyle" TargetType="Border" BasedOn="{StaticResource StatusOkStyle}">
            <Setter Property="Background" Value="#26EF4444" />
            <Setter Property="BorderBrush" Value="#66EF4444" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer Background="{StaticResource PageBackground}" VerticalScrollBarVisibility="Auto">
        <Grid Margin="24,0,24,24" Background="{StaticResource PageGridBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 行0：报警横幅（状态驱动） -->
            <Border
                Grid.Row="0"
                Margin="0,12,0,12"
                Padding="24,14"
                BorderThickness="2"
                CornerRadius="4">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
                        <Setter Property="Effect">
                            <Setter.Value>
                                <DropShadowEffect BlurRadius="0" Direction="0" Opacity="0" ShadowDepth="0" Color="#EF4444" />
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasAnySpliceAlarm}" Value="True">
                                <Setter Property="BorderBrush" Value="#EF4444" />
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="24" Color="#EF4444" Opacity="0.35" ShadowDepth="0" />
                                    </Setter.Value>
                                </Setter>
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard Name="BannerPulse">
                                        <Storyboard AutoReverse="True" RepeatBehavior="Forever">
                                            <ColorAnimation
                                                Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                Duration="0:0:0.8"
                                                From="#EF4444"
                                                To="#66EF4444" />
                                            <DoubleAnimation
                                                Storyboard.TargetProperty="(Border.Effect).(DropShadowEffect.Opacity)"
                                                Duration="0:0:0.8"
                                                From="0.7"
                                                To="0.3" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="BannerPulse" />
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                        <Ellipse Width="14" Height="14">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource Success}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasAnySpliceAlarm}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource Error}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="14"
                            FontWeight="Bold"
                            Text="{Binding BannerText}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource Success}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasAnySpliceAlarm}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Error}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Ellipse Width="14" Height="14" Margin="16,0,0,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource Success}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasAnySpliceAlarm}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource Error}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 行1：三卡片 -->
            <UniformGrid Grid.Row="1" Columns="3">

                <!-- P-01 前段搭接 -->
                <Border
                    Margin="0,0,24,0"
                    Padding="20"
                    Background="{StaticResource Surface}"
                    BorderThickness="1"
                    CornerRadius="4">
                    <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{StaticResource Border}" />
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="0" Direction="0" Opacity="0" ShadowDepth="0" Color="#EF4444" />
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                <DataTrigger Binding="{Binding SpliceValue1OutOfRange}" Value="True">
                                    <Setter Property="BorderBrush" Value="#EF4444" />
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect BlurRadius="50" Color="#EF4444" Opacity="0.7" ShadowDepth="0" />
                                        </Setter.Value>
                                    </Setter>
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard Name="CardPulse1">
                                            <Storyboard AutoReverse="True" RepeatBehavior="Forever">
                                                <ColorAnimation
                                                    Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                    Duration="0:0:0.8"
                                                    From="#EF4444"
                                                    To="#66EF4444" />
                                                <DoubleAnimation
                                                    Storyboard.TargetProperty="(Border.Effect).(DropShadowEffect.Opacity)"
                                                    Duration="0:0:0.8"
                                                    From="0.7"
                                                    To="0.3" />
                                                <DoubleAnimation
                                                    Storyboard.TargetProperty="(Border.Effect).(DropShadowEffect.BlurRadius)"
                                                    Duration="0:0:0.8"
                                                    From="50"
                                                    To="20" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <StopStoryboard BeginStoryboardName="CardPulse1" />
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.Resources>
                            <Style x:Key="CornerStyle1" TargetType="Path">
                                <Setter Property="Stroke" Value="{StaticResource Primary}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SpliceValue1OutOfRange}" Value="True">
                                        <Setter Property="Stroke" Value="{StaticResource Error}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Resources>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Path
                            Style="{StaticResource CornerStyle1}"
                            Margin="-10,-13,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Data="M 16 2 L 2 2 L 2 16"
                            Stretch="None"
                            StrokeThickness="2" />
                        <Path
                            Style="{StaticResource CornerStyle1}"
                            Margin="0,-13,-10,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Data="M 2 2 L 16 2 L 16 16"
                            Stretch="None"
                            StrokeThickness="2" />
                        <Path
                            Style="{StaticResource CornerStyle1}"
                            Margin="-6,0,0,-13"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Data="M 2 2 L 2 16 L 16 16"
                            Stretch="None"
                            StrokeThickness="2" Grid.Row="4" />
                        <Path
                            Style="{StaticResource CornerStyle1}"
                            Margin="0,0,-8,-13"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Data="M 16 2 L 16 16 L 2 16"
                            Stretch="None"
                            StrokeThickness="2" Grid.Row="4" />

                        <Border
                            Margin="0,0,0,16"
                            Padding="0,0,0,12"
                            BorderBrush="{StaticResource Line}"
                            BorderThickness="0,0,0,1">
                            <DockPanel>
                                <Border
                                    DockPanel.Dock="Right"
                                    Margin="8,0,0,0"
                                    Padding="8,3"
                                    BorderThickness="1"
                                    CornerRadius="2"
                                    VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#1A22C55E" />
                                            <Setter Property="BorderBrush" Value="#4D22C55E" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SpliceValue1OutOfRange}" Value="True">
                                                    <Setter Property="Background" Value="#26EF4444" />
                                                    <Setter Property="BorderBrush" Value="#66EF4444" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="10" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource Success}" />
                                                <Setter Property="Text" Value="NORMAL" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SpliceValue1OutOfRange}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource Error}" />
                                                        <Setter Property="Text" Value="ALARM" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <Border>
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource PositionBadgeStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SpliceValue1OutOfRange}" Value="True">
                                                    <Setter Property="Background" Value="#19EF4444" />
                                                    <Setter Property="BorderBrush" Value="#66EF4444" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            FontFamily="Consolas"
                                            FontSize="13"
                                            FontWeight="Bold"
                                            Text="P-01">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource Primary}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SpliceValue1OutOfRange}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource Error}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock
                                            Margin="10,0,0,0"
                                            FontSize="12"
                                            Foreground="{StaticResource Ink2}"
                                            Text="前段搭接 / FRONT" />
                                    </StackPanel>
                                </Border>
                            </DockPanel>
                        </Border>

                        <ctl:HslArcGauge Grid.Row="1"
                                Margin="0,8,0,0"
                                HorizontalAlignment="Center"
                                Width="240"
                                Height="160"
                                Background="Transparent"
                                Foreground="{StaticResource Ink2}"
                                GaugeUnit="mm"
                                ArcGaugeFormat="F1"
                                Min="0"
                                Max="8"
                                SettingValue="4"
                                SettingGaugeColor="{StaticResource Warning}"
                                Value="{Binding SpliceValue1Value}">
                            <ctl:HslArcGauge.Style>
                                <Style TargetType="ctl:HslArcGauge">
                                    <Setter Property="GaugeColor" Value="{StaticResource Success}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SpliceValue1OutOfRange}" Value="True">
                                            <Setter Property="GaugeColor" Value="{StaticResource Error}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ctl:HslArcGauge.Style>
                        </ctl:HslArcGauge>

                        <DockPanel Grid.Row="2" Margin="0,10,0,0">
                            <TextBlock DockPanel.Dock="Left" FontSize="10" Foreground="{StaticResource Ink3}" Text="搭接示意 / OVERLAP SCHEMATIC" />
                            <Rectangle Height="1" Margin="12,0,0,0" VerticalAlignment="Center" Fill="#80374151" />
                        </DockPanel>
                        <Viewbox Grid.Row="3" MaxWidth="347" Stretch="Uniform">
                            <Canvas Width="400" Height="110">
                                <Rectangle Canvas.Left="21" Canvas.Top="45" Width="200" Height="40" Stroke="#6B7280">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#475569" Offset="0" />
                                            <GradientStop Color="#374151" Offset="1" />
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <Rectangle Canvas.Left="179" Canvas.Top="45" Width="200" Height="40" Stroke="#7B8290">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#5A6478" Offset="0" />
                                            <GradientStop Color="#475569" Offset="1" />
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <TextBlock Canvas.Left="29" Canvas.Top="49" FontSize="9" Foreground="#99FFFFFF" Text="材料A" />
                                <TextBlock Canvas.Left="187" Canvas.Top="49" FontSize="9" Foreground="#99FFFFFF" Text="材料B" />
                                <Rectangle
                                    Canvas.Left="179"
                                    Canvas.Top="45"
                                    Width="42"
                                    Height="40"
                                    StrokeDashArray="3 2">
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle">
                                            <Setter Property="Fill" Value="#1422C55E" />
                                            <Setter Property="Stroke" Value="{StaticResource Success}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SpliceValue1OutOfRange}" Value="True">
                                                    <Setter Property="Fill" Value="#1AEF4444" />
                                                    <Setter Property="Stroke" Value="{StaticResource Error}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Rectangle.Style>
                                </Rectangle>
                                <Path Data="M 179 38 L 221 38 M 179 34 L 179 42 M 221 34 L 221 42">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Stroke" Value="{StaticResource Success}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SpliceValue1OutOfRange}" Value="True">
                                                    <Setter Property="Stroke" Value="{StaticResource Error}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <TextBlock
                                    Canvas.Left="169"
                                    Canvas.Top="20"
                                    Width="62"
                                    FontFamily="Consolas"
                                    FontSize="10"
                                    TextAlignment="Center"
                                    Text="{Binding SpliceValue1Value, StringFormat={}{0:F1}mm}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource Success}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SpliceValue1OutOfRange}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Error}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Canvas>
                        </Viewbox>

                        <Border
                            Grid.Row="4"
                            Margin="0,10,0,0"
                            Padding="0,12,0,0"
                            BorderBrush="{StaticResource Line}"
                            BorderThickness="0,1,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontSize="10" Foreground="{StaticResource Ink3}" Text="标准: " />
                                    <TextBlock FontSize="10" FontWeight="Bold" Foreground="{StaticResource Ink2}" Text="4±2mm" />
                                </StackPanel>
                                <TextBlock
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    FontSize="10"
                                    FontWeight="Bold"
                                    Text="{Binding SpliceValue1Delta}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource Success}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SpliceValue1OutOfRange}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Error}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- P-02 中段搭接 -->
                <Border
                    Margin="0,0,24,0"
                    Padding="20"
                    Background="{StaticResource Surface}"
                    BorderThickness="1"
                    CornerRadius="4">
                    <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{StaticResource Border}" />
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="0" Direction="0" Opacity="0" ShadowDepth="0" Color="#EF4444" />
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                <DataTrigger Binding="{Binding SpliceValue2OutOfRange}" Value="True">
                                    <Setter Property="BorderBrush" Value="#EF4444" />
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect BlurRadius="50" Color="#EF4444" Opacity="0.7" ShadowDepth="0" />
                                        </Setter.Value>
                                    </Setter>
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard Name="CardPulse2">
                                            <Storyboard AutoReverse="True" RepeatBehavior="Forever">
                                                <ColorAnimation
                                                    Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                    Duration="0:0:0.8"
                                                    From="#EF4444"
                                                    To="#66EF4444" />
                                                <DoubleAnimation
                                                    Storyboard.TargetProperty="(Border.Effect).(DropShadowEffect.Opacity)"
                                                    Duration="0:0:0.8"
                                                    From="0.7"
                                                    To="0.3" />
                                                <DoubleAnimation
                                                    Storyboard.TargetProperty="(Border.Effect).(DropShadowEffect.BlurRadius)"
                                                    Duration="0:0:0.8"
                                                    From="50"
                                                    To="20" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <StopStoryboard BeginStoryboardName="CardPulse2" />
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.Resources>
                            <Style x:Key="CornerStyle2" TargetType="Path">
                                <Setter Property="Stroke" Value="{StaticResource Primary}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SpliceValue2OutOfRange}" Value="True">
                                        <Setter Property="Stroke" Value="{StaticResource Error}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Resources>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Path
                            Style="{StaticResource CornerStyle2}"
                            Margin="-6,-13,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Data="M 16 2 L 2 2 L 2 16"
                            Stretch="None"
                            StrokeThickness="2" />
                        <Path
                            Style="{StaticResource CornerStyle2}"
                            Margin="0,-12,-10,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Data="M 2 2 L 16 2 L 16 16"
                            Stretch="None"
                            StrokeThickness="2" />
                        <Path
                            Style="{StaticResource CornerStyle2}"
                            Margin="-5,0,0,-13"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Data="M 2 2 L 2 16 L 16 16"
                            Stretch="None"
                            StrokeThickness="2" Grid.Row="4" />
                        <Path
                            Style="{StaticResource CornerStyle2}"
                            Grid.RowSpan="5"
                            Margin="0,0,-13,-13"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Data="M 16 2 L 16 16 L 2 16"
                            Stretch="None"
                            StrokeThickness="2" />

                        <Border
                            Margin="0,0,0,16"
                            Padding="0,0,0,12"
                            BorderBrush="{StaticResource Line}"
                            BorderThickness="0,0,0,1">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Border
                                        Margin="8,0,0,0"
                                        Padding="8,3"
                                        BorderThickness="1"
                                        CornerRadius="2"
                                        VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#1A22C55E" />
                                                <Setter Property="BorderBrush" Value="#4D22C55E" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SpliceValue2OutOfRange}" Value="True">
                                                        <Setter Property="Background" Value="#26EF4444" />
                                                        <Setter Property="BorderBrush" Value="#66EF4444" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="10" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource Success}" />
                                                    <Setter Property="Text" Value="NORMAL" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SpliceValue2OutOfRange}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource Error}" />
                                                            <Setter Property="Text" Value="ALARM" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                                <Border>
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource PositionBadgeStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SpliceValue2OutOfRange}" Value="True">
                                                    <Setter Property="Background" Value="#19EF4444" />
                                                    <Setter Property="BorderBrush" Value="#66EF4444" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            FontFamily="Consolas"
                                            FontSize="13"
                                            FontWeight="Bold"
                                            Text="P-02">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource Primary}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SpliceValue2OutOfRange}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource Error}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock
                                            Margin="10,0,0,0"
                                            FontSize="12"
                                            Foreground="{StaticResource Ink2}"
                                            Text="中段搭接 / CENTER" />
                                    </StackPanel>
                                </Border>
                            </DockPanel>
                        </Border>

