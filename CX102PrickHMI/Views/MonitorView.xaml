<UserControl
    x:Class="CX102PrickHMI.Views.MonitorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="clr-namespace:CX102PrickHMI.Behaviors"
    xmlns:ctl="clr-namespace:HslControls.WPF;assembly=HslControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:CX102PrickHMI.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:MonitorViewModel}"
    Background="{StaticResource PageBackground}"
    mc:Ignorable="d">
    <Grid Margin="24,0,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock
            Margin="0,20,0,12"
            FontSize="20"
            FontWeight="SemiBold"
            Foreground="{StaticResource Ink}"
            Text="刺辊监控" />
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <Grid Margin="0,0,24,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Border Margin="0,0,12,0" Style="{StaticResource PanelStyle}">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,16"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource Ink}"
                            Text="当前配方值" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{StaticResource Ink3}"
                            Text="内侧刺针环" />
                        <TextBlock
                            Margin="0,2,0,12"
                            FontFamily="Consolas"
                            FontSize="30"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource Ink}"><Run Text="{Binding RecipeRing1, Mode=OneWay}" /><Run
                                FontSize="14"
                                FontWeight="Normal"
                                Foreground="{StaticResource Ink2}"
                                Text=" mm" /></TextBlock>
                        <Border
                            Padding="0,12,0,0"
                            BorderBrush="{StaticResource Line}"
                            BorderThickness="0,1,0,0">
                            <StackPanel>
                                <!--<ctl:HslArcGauge   Max="6" Min="5"  Value="2.2"  SettingGaugeColor="Orange"  GaugeColor="Red"   GaugeUnit="mm"/>-->
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{StaticResource Ink3}"
                                    Text="外侧刺针环" />
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontSize="30"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource Ink}"><Run Text="{Binding RecipeRing2, Mode=OneWay}" /><Run
                                        FontSize="14"
                                        FontWeight="Normal"
                                        Foreground="{StaticResource Ink2}"
                                        Text=" mm" /></TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
                <Border
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    Style="{StaticResource PanelStyle}">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,16"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource Ink}"
                            Text="当前实际值" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{StaticResource Ink3}"
                            Text="内侧刺针环" />
                        <TextBlock
                            Margin="0,2,0,12"
                            FontFamily="Consolas"
                            FontSize="30"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource Primary}"><Run Text="{Binding ActualRing1, Mode=OneWay}" /><Run
                                FontSize="14"
                                FontWeight="Normal"
                                Foreground="{StaticResource Ink2}"
                                Text=" mm" /></TextBlock>
                        <Border
                            Padding="0,12,0,0"
                            BorderBrush="{StaticResource Line}"
                            BorderThickness="0,1,0,0">
                            <StackPanel>
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{StaticResource Ink3}"
                                    Text="外侧刺针环" />
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontSize="30"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource Primary}"><Run Text="{Binding ActualRing2, Mode=OneWay}" /><Run
                                        FontSize="14"
                                        FontWeight="Normal"
                                        Foreground="{StaticResource Ink2}"
                                        Text=" mm" /></TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
                <Border
                    Grid.Row="1"
                    Grid.ColumnSpan="2"
                    Margin="0,24,0,0"
                    Style="{StaticResource PanelStyle}">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,18"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource Ink}"
                            Text="伺服控制" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock
                                    Margin="0,0,0,4"
                                    FontSize="12"
                                    Foreground="{StaticResource Ink3}"
                                    Text="内侧伺服 校准原点值" />
                                <TextBox Text="{Binding HomingRefPosInText, Mode=OneWay}">
                                    <TextBox.InputBindings>
                                        <MouseBinding Command="{Binding OpenKeypadInCommand}" MouseAction="LeftClick" />
                                    </TextBox.InputBindings>
                                    <TextBox.Style>
                                        <Style BasedOn="{StaticResource ReadonlyValueBoxStyle}" TargetType="TextBox">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HomingRefPosInInvalid}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource Error}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock
                                    Margin="0,0,0,4"
                                    FontSize="12"
                                    Foreground="{StaticResource Ink3}"
                                    Text="外侧伺服 校准原点值" />
                                <TextBox Text="{Binding HomingRefPosOutText, Mode=OneWay}">
                                    <TextBox.InputBindings>
                                        <MouseBinding Command="{Binding OpenKeypadOutCommand}" MouseAction="LeftClick" />
                                    </TextBox.InputBindings>
                                    <TextBox.Style>
                                        <Style BasedOn="{StaticResource ReadonlyValueBoxStyle}" TargetType="TextBox">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HomingRefPosOutInvalid}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource Error}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </StackPanel>
                        </Grid>
                        <StackPanel Margin="0,18,0,18" Orientation="Horizontal">
                            <Button
                                Margin="0,0,12,0"
                                b:MomentaryButtonBehavior.Command="{Binding HoldJogFwdCommand}"
                                Content="点动前进"
                                Style="{StaticResource HoldButtonStyle}" />
                            <Button
                                Margin="0,0,12,0"
                                b:MomentaryButtonBehavior.Command="{Binding HoldJogBwdCommand}"
                                Content="点动后退"
                                Style="{StaticResource HoldButtonStyle}" />
                            <Button
                                Margin="0,0,12,0"
                                b:MomentaryButtonBehavior.Command="{Binding HoldHomingInCommand}"
                                Content="校准内侧"
                                Style="{StaticResource HoldButtonStyle}" />
                            <Button
                                Margin="0,0,12,0"
                                b:MomentaryButtonBehavior.Command="{Binding HoldHomingOutCommand}"
                                Content="校准外侧"
                                Style="{StaticResource HoldButtonStyle}" />
                            <Button b:MomentaryButtonBehavior.Command="{Binding HoldSetupCommand}" Content="设置">
                                <Button.Style>
                                    <Style BasedOn="{StaticResource HoldButtonStyle}" TargetType="Button">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StsNewRcpBlink}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource Primary}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <TextBlock
                                Margin="24,0,0,0"
                                VerticalAlignment="Center"
                                Foreground="{StaticResource Ink}"
                                Text="维修模式" />
                            <TextBlock
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="未激活" />
                                        <Setter Property="Foreground" Value="{StaticResource Ink3}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TriggerMaintenance}" Value="True">
                                                <Setter Property="Text" Value="激活" />
                                                <Setter Property="Foreground" Value="{StaticResource Success}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <TextBlock
                            Margin="0,0,0,16"
                            FontSize="12"
                            Foreground="{StaticResource Ink3}"
                            Text="{Binding CalibrationMessage}" />
                        <Border
                            Padding="0,16,0,0"
                            BorderBrush="{StaticResource Line}"
                            BorderThickness="0,1,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        FontSize="13"
                                        Foreground="{StaticResource Ink}"
                                        Text="内侧伺服" />
                                    <Ellipse
                                        Width="12"
                                        Height="12"
                                        Margin="16,0,6,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource Ink3}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding StsHomingDoneIn}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource Success}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock FontSize="13">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource Ink2}" />
                                                <Setter Property="Text" Value="未回原" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding StsHomingDoneIn}" Value="True">
                                                        <Setter Property="Text" Value="已回原" />
                                                        <Setter Property="Foreground" Value="{StaticResource Ink}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock
                                        FontSize="13"
                                        Foreground="{StaticResource Ink}"
                                        Text="外侧伺服" />
                                    <Ellipse
                                        Width="12"
                                        Height="12"
                                        Margin="16,0,6,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource Ink3}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding StsHomingDoneOut}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource Success}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock FontSize="13">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource Ink2}" />
                                                <Setter Property="Text" Value="未回原" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding StsHomingDoneOut}" Value="True">
                                                        <Setter Property="Text" Value="已回原" />
                                                        <Setter Property="Foreground" Value="{StaticResource Ink}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
            <Border Grid.Column="1" Style="{StaticResource PanelStyle}">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,16"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource Ink}"
                        Text="设备状态" />
                    <Border
                        Height="180"
                        Margin="0,0,0,16"
                        Background="{StaticResource Surface2}"
                        BorderThickness="2"
                        CornerRadius="8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{StaticResource Line}" />
                                <Setter Property="Opacity" Value="1" />
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect
                                            BlurRadius="0"
                                            Direction="0"
                                            Opacity="0"
                                            ShadowDepth="0"
                                            Color="#00EF4444" />
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAlarmActive}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard Name="AlarmPulseStoryboard">
                                                <Storyboard AutoReverse="True" RepeatBehavior="Forever">
                                                    <ColorAnimation
                                                        Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                        From="#00EF4444"
                                                        To="#EF4444"
                                                        Duration="0:0:1" />
                                                    <DoubleAnimation
                                                        Storyboard.TargetProperty="Opacity"
                                                        From="0.72"
                                                        To="1"
                                                        Duration="0:0:1" />
                                                    <DoubleAnimation
                                                        Storyboard.TargetProperty="(Border.Effect).(DropShadowEffect.Opacity)"
                                                        From="0.08"
                                                        To="0.9"
                                                        Duration="0:0:1" />
                                                    <DoubleAnimation
                                                        Storyboard.TargetProperty="(Border.Effect).(DropShadowEffect.BlurRadius)"
                                                        From="4"
                                                        To="18"
                                                        Duration="0:0:1" />
                                                    <DoubleAnimation
                                                        Storyboard.TargetProperty="(Border.Effect).(DropShadowEffect.ShadowDepth)"
                                                        From="0"
                                                        To="2"
                                                        Duration="0:0:1" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="AlarmPulseStoryboard" />
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Image Source="/CX102PrickHMI;component/Assets/spike-roller-device.png" Stretch="Uniform" />
                    </Border>
                    <Border
                        Padding="0,10"
                        BorderBrush="{StaticResource Line}"
                        BorderThickness="0,0,0,1">
                        <DockPanel>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource Ink}" />
                                        <Setter Property="Text" Value="主机运行中" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding MainMachineStop}" Value="True">
                                                <Setter Property="Text" Value="主机已停机" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Ellipse
                                Width="12"
                                Height="12"
                                Margin="22,0,0,0"
                                DockPanel.Dock="Right">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource Success}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding MainMachineStop}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource Ink3}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                        </DockPanel>
                    </Border>
                    <Border
                        Padding="0,10"
                        BorderBrush="{StaticResource Line}"
                        BorderThickness="0,0,0,1">
                        <DockPanel>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource Ink}" />
                                        <Setter Property="Text" Value="内侧电机未使能" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DriveInEnable}" Value="True">
                                                <Setter Property="Text" Value="内侧电机已使能" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Ellipse
                                Width="12"
                                Height="12"
                                DockPanel.Dock="Right">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource Ink3}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DriveInEnable}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource Success}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                        </DockPanel>
                    </Border>
                    <Border
                        Margin="0,0,0,0"
                        Padding="0,10"
                        BorderBrush="{StaticResource Line}"
                        BorderThickness="0,0,0,1">
                        <DockPanel>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource Ink}" />
                                        <Setter Property="Text" Value="外侧电机未使能" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DriveOutEnable}" Value="True">
                                                <Setter Property="Text" Value="外侧电机已使能" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Ellipse
                                Width="12"
                                Height="12"
                                DockPanel.Dock="Right">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource Ink3}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DriveOutEnable}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource Success}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                        </DockPanel>
                    </Border>
                    <DockPanel Margin="0,10,0,0">
                        <TextBlock Foreground="{StaticResource Ink}" Text="报警 0 条" />
                        <Ellipse
                            Width="12"
                            Height="12"
                            Margin="35,0,0,0"
                            DockPanel.Dock="Right"
                            Fill="{StaticResource Primary}" />
                    </DockPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
